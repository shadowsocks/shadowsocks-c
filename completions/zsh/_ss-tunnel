#compdef ss-tunnel

local ciphers
ciphers='(aes-128-gcm aes-192-gcm aes-256-gcm chacha20-ietf-poly1305 xchacha20-ietf-poly1305 2022-blake3-aes-128-gcm 2022-blake3-aes-256-gcm 2022-blake3-chacha20-poly1305)'

_arguments "-h::" \
           "-s:server host:_hosts" \
           "-p:server port:" \
           "-l:local port:" \
           "-k:password:" \
           "-m:encrypt method:$ciphers" \
           "-a:run as user:_users" \
           "-f:pid file:_files" \
           "-t:timeout:" \
           "-c:configure file:_files" \
           "-n:nofile:" \
           "-i:bind interface:_net_interfaces" \
           "-b:local address:(127.0.0.1 \:\:1 0.0.0.0 \:\:)" \
           "-u:enable udp:" \
           "-U:udp only:" \
           "-v:verbose mode:" \
           "-L:destination server address and port:" \
           "--reuse-port::" \
           "--acl:acl file:_files" \
           "--mtu::" \
           "--key:key in base64:" \
           "--plugin:plugin name:" \
           "--plugin-opts:plugin options:" \
           "--help::"

