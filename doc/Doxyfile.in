PROJECT_NAME           = "shadowsocks-c"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@PROJECT_BINARY_DIR@"
INPUT                  = @DOXYGEN_INPUT@
INPUT_ENCODING         = UTF-8
EXAMPLE_PATH           = "@PROJECT_SOURCE_DIR@/src" "@PROJECT_SOURCE_DIR@/src/crypto"
EXAMPLE_PATTERNS        = *.c ss-nat
RECURSIVE              = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = NO
EXTRACT_ALL            = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = YES
GENERATE_HTML          = @DOXYGEN_HTML@
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_MAN           = @DOXYGEN_MAN@
MAN_OUTPUT             = man
MAN_SUBDIR             = .
MAN_EXTENSION          = @DOXYGEN_MAN_EXTENSION@
MAN_LINKS              = NO
GENERATE_LATEX         = NO
HAVE_DOT               = NO
STRIP_CODE_COMMENTS    = YES
